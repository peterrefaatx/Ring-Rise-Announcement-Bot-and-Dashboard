# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cold_calling_platform?schema=public"

# Required in production: 32+ random characters used for session signing and encrypting stored secrets
AUTH_SECRET="replace-with-a-strong-32-char-minimum-random-secret"

# Set to "true" when served behind HTTPS in production
FORCE_SECURE_COOKIES="false"

# Optional initial admin bootstrap credentials for seeding (change immediately after first login)
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="ChangeMeImmediately123!"

# Optional Telegram fallback configuration (can also be configured in Admin Settings UI)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional branding defaults
BRAND_NAME="Daily Dashboard"
BRAND_TAGLINE="Real-Time Lead & Campaign Tracker"
BRAND_PRIMARY_COLOR="#1D4ED8"

# Server port
PORT="3000"
